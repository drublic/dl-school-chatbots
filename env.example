# Copy to .env.local for Next.js
# cp env.example .env.local

# Required for streaming chat (Step 3+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required when you wire RAG (Step 5) — embedding model MUST match Session 3 ingest
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
PINECONE_INDEX=workshop-shared

# Optional — wire Session 3 handbook MCP (Step 4)
# Absolute path to dl-school-agentic (or your local clone of that repo)
HANDBOOK_MCP_CWD=
# Defaults shown; override if your paths differ
# HANDBOOK_MCP_COMMAND=npx
# HANDBOOK_MCP_ARGS=tsx,example/mcp/handbook-server.ts
