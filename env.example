# Copy to .env.local for Next.js
# cp env.example .env.local

# Required: OpenAI (direct provider; no AI Gateway)
OPENAI_API_KEY=

# Chat replies (Responses / streamText)
OPENAI_MODEL=gpt-5-mini

# Intent routing via Decisions API (choice); default gpt-6-luna
OPENAI_DECISION_MODEL=gpt-6-luna

# Required for season answers: Postgres connection string (Supabase → Project Settings → Database)
# Example: postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Apply schema + seed once the DB exists:
#   DATABASE_URL=... npm run db:seed
